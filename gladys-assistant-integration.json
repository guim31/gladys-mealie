{
  "manifest_version": 1,
  "type": "device",
  "name": "Mealie",
  "description": {
    "en": "Your Mealie meal plan and shopping lists in Gladys: menus, scenes and widgets.",
    "fr": "Le planning des repas et les listes de courses de Mealie dans Gladys.",
    "de": "Essensplan und Einkaufslisten von Mealie in Gladys: Menüs, Szenen, Widgets.",
    "es": "El menú y las listas de la compra de Mealie en Gladys: escenas y widgets."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-mealie:1.0.1",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-mealie/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Mealie",
        "fr": "Votre Mealie",
        "de": "Dein Mealie",
        "es": "Su Mealie"
      },
      "description": {
        "en": "In Mealie, open your profile, then API Tokens, generate a token and paste it below with the address of Mealie. Then add the Mealie device from the Discover tab.",
        "fr": "Dans Mealie, ouvrez votre profil, puis Jetons de l'API, générez un jeton et collez-le ci-dessous avec l'adresse de Mealie. Ajoutez ensuite l'appareil Mealie depuis l'onglet Découverte.",
        "de": "Öffne in Mealie dein Profil, dann API-Token, erzeuge ein Token und füge es unten mit der Adresse von Mealie ein. Lege dann das Gerät Mealie im Tab „Entdecken“ an.",
        "es": "En Mealie, abra su perfil y luego API Tokens, genere un token y péguelo abajo con la dirección de Mealie. Después, añada el dispositivo Mealie desde la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-mealie/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://docs.mealie.io/documentation/getting-started/api-usage/",
          "label": {
            "en": "Mealie API tokens",
            "fr": "Jetons d'API de Mealie",
            "de": "API-Token von Mealie",
            "es": "Tokens de API de Mealie"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Mealie address",
        "fr": "Adresse de Mealie",
        "de": "Adresse von Mealie",
        "es": "Dirección de Mealie"
      },
      "description": {
        "en": "The address you open Mealie with, port included (9925 by default with Docker).",
        "fr": "L'adresse avec laquelle vous ouvrez Mealie, port compris (9925 par défaut avec Docker).",
        "de": "Die Adresse, mit der du Mealie öffnest, mit Port (mit Docker standardmäßig 9925).",
        "es": "La dirección con la que abre Mealie, puerto incluido (9925 por defecto con Docker)."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.2:9925",
        "fr": "ex. http://192.168.1.2:9925",
        "de": "z. B. http://192.168.1.2:9925",
        "es": "p. ej. http://192.168.1.2:9925"
      },
      "required": true
    },
    {
      "key": "api_token",
      "type": "secret",
      "label": {
        "en": "API token",
        "fr": "Jeton d'API",
        "de": "API-Token",
        "es": "Token de API"
      },
      "description": {
        "en": "Created in Mealie: profile → API Tokens → Generate. It acts with the rights of your user.",
        "fr": "Créé dans Mealie : profil → Jetons de l'API → Générer. Il agit avec les droits de votre utilisateur.",
        "de": "Erstellt in Mealie: Profil → API-Token → Erzeugen. Es handelt mit den Rechten deines Benutzers.",
        "es": "Creado en Mealie: perfil → API Tokens → Generar. Actúa con los permisos de su usuario."
      },
      "required": true
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept self-signed certificates",
        "fr": "Accepter les certificats auto-signés",
        "de": "Selbstsignierte Zertifikate akzeptieren",
        "es": "Aceptar certificados autofirmados"
      },
      "description": {
        "en": "Only for an https:// address whose certificate your browser does not trust either.",
        "fr": "Seulement pour une adresse en https:// dont le certificat n'est pas reconnu non plus par votre navigateur.",
        "de": "Nur für eine https://-Adresse, deren Zertifikat auch dein Browser nicht anerkennt.",
        "es": "Solo para una dirección https:// cuyo certificado tampoco reconoce su navegador."
      },
      "required": false,
      "default": false
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Mealie is read. Gladys' own changes show at once.",
        "fr": "Fréquence de lecture de Mealie. Les changements faits depuis Gladys s'affichent tout de suite.",
        "de": "Wie oft Mealie gelesen wird. Änderungen aus Gladys erscheinen sofort.",
        "es": "Frecuencia de lectura de Mealie. Los cambios hechos desde Gladys se ven al instante."
      },
      "required": false,
      "default": "300",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        },
        {
          "value": "900",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names and messages",
        "fr": "Langue des noms et des messages",
        "de": "Sprache der Namen und Meldungen",
        "es": "Idioma de los nombres y mensajes"
      },
      "description": {
        "en": "Names of the features (set when the device is added) and texts of the scene actions.",
        "fr": "Noms des fonctionnalités (fixés à l'ajout de l'appareil) et textes des actions de scène.",
        "de": "Namen der Funktionen (beim Anlegen des Geräts festgelegt) und Texte der Szenen-Aktionen.",
        "es": "Nombres de las funciones (fijados al añadir el dispositivo) y textos de las acciones de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "English",
            "de": "English",
            "es": "English"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "Français",
            "fr": "Français",
            "de": "Français",
            "es": "Français"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "Deutsch",
            "fr": "Deutsch",
            "de": "Deutsch",
            "es": "Deutsch"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Español",
            "fr": "Español",
            "de": "Español",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_actions": [
    {
      "key": "add_shopping_item",
      "label": {
        "en": "Add to the shopping list",
        "fr": "Ajouter à la liste de courses",
        "de": "Zur Einkaufsliste hinzufügen",
        "es": "Añadir a la lista de la compra"
      },
      "description": {
        "en": "Adds an item to a Mealie shopping list, unless it is already on it.",
        "fr": "Ajoute un article à une liste de courses Mealie, sauf s'il y est déjà.",
        "de": "Fügt einen Eintrag zu einer Einkaufsliste von Mealie hinzu, außer er steht schon darauf.",
        "es": "Añade un artículo a una lista de la compra de Mealie, salvo si ya está en ella."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "item",
          "type": "string",
          "label": {
            "en": "Item",
            "fr": "Article",
            "de": "Eintrag",
            "es": "Artículo"
          },
          "description": {
            "en": "As it should read on the list.",
            "fr": "Tel qu'il doit s'afficher sur la liste.",
            "de": "So, wie er auf der Liste stehen soll.",
            "es": "Tal como debe aparecer en la lista."
          },
          "placeholder": {
            "en": "e.g. Milk",
            "fr": "ex. Lait",
            "de": "z. B. Milch",
            "es": "p. ej. Leche"
          },
          "required": true
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "Shopping list",
            "fr": "Liste de courses",
            "de": "Einkaufsliste",
            "es": "Lista de la compra"
          },
          "description": {
            "en": "Its name in Mealie. Empty: the first list created.",
            "fr": "Son nom dans Mealie. Vide : la première liste créée.",
            "de": "Der Name der Liste in Mealie. Leer: die zuerst erstellte Liste.",
            "es": "Su nombre en Mealie. Vacío: la primera lista creada."
          },
          "placeholder": {
            "en": "e.g. Groceries",
            "fr": "ex. Courses",
            "de": "z. B. Einkäufe",
            "es": "p. ej. Compras"
          },
          "required": false
        }
      ],
      "outputs": [
        {
          "key": "added",
          "type": "boolean",
          "label": {
            "en": "Item added",
            "fr": "Article ajouté",
            "de": "Eintrag hinzugefügt",
            "es": "Artículo añadido"
          }
        },
        {
          "key": "item",
          "type": "string",
          "label": {
            "en": "Item",
            "fr": "Article",
            "de": "Eintrag",
            "es": "Artículo"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "Shopping list",
            "fr": "Liste de courses",
            "de": "Einkaufsliste",
            "es": "Lista de la compra"
          }
        },
        {
          "key": "to_buy",
          "type": "number",
          "label": {
            "en": "Items to buy",
            "fr": "Articles à acheter",
            "de": "Einträge zu kaufen",
            "es": "Artículos por comprar"
          }
        }
      ]
    },
    {
      "key": "check_shopping_item",
      "label": {
        "en": "Check a shopping list item",
        "fr": "Cocher un article de la liste de courses",
        "de": "Eintrag der Einkaufsliste abhaken",
        "es": "Marcar un artículo de la lista de la compra"
      },
      "description": {
        "en": "Checks an item still to buy, as in the Mealie app (unchecking it there undoes it).",
        "fr": "Coche un article encore à acheter, comme dans l'appli Mealie (le décocher là-bas l'annule).",
        "de": "Hakt einen noch zu kaufenden Eintrag ab, wie in der Mealie-App (dort abwählen macht es rückgängig).",
        "es": "Marca un artículo aún por comprar, como en la app de Mealie (desmarcarlo allí lo deshace)."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "item",
          "type": "string",
          "label": {
            "en": "Item",
            "fr": "Article",
            "de": "Eintrag",
            "es": "Artículo"
          },
          "description": {
            "en": "Its name on the list, upper case and accents ignored.",
            "fr": "Son nom sur la liste, sans tenir compte des majuscules ni des accents.",
            "de": "Sein Name auf der Liste, Groß- und Kleinschreibung und Akzente egal.",
            "es": "Su nombre en la lista, sin tener en cuenta mayúsculas ni acentos."
          },
          "placeholder": {
            "en": "e.g. Milk",
            "fr": "ex. Lait",
            "de": "z. B. Milch",
            "es": "p. ej. Leche"
          },
          "required": true
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "Shopping list",
            "fr": "Liste de courses",
            "de": "Einkaufsliste",
            "es": "Lista de la compra"
          },
          "description": {
            "en": "Its name in Mealie. Empty: the first list created.",
            "fr": "Son nom dans Mealie. Vide : la première liste créée.",
            "de": "Der Name der Liste in Mealie. Leer: die zuerst erstellte Liste.",
            "es": "Su nombre en Mealie. Vacío: la primera lista creada."
          },
          "placeholder": {
            "en": "e.g. Groceries",
            "fr": "ex. Courses",
            "de": "z. B. Einkäufe",
            "es": "p. ej. Compras"
          },
          "required": false
        }
      ],
      "outputs": [
        {
          "key": "checked",
          "type": "boolean",
          "label": {
            "en": "Item checked",
            "fr": "Article coché",
            "de": "Eintrag abgehakt",
            "es": "Artículo marcado"
          }
        },
        {
          "key": "item",
          "type": "string",
          "label": {
            "en": "Item",
            "fr": "Article",
            "de": "Eintrag",
            "es": "Artículo"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "Shopping list",
            "fr": "Liste de courses",
            "de": "Einkaufsliste",
            "es": "Lista de la compra"
          }
        },
        {
          "key": "to_buy",
          "type": "number",
          "label": {
            "en": "Items to buy",
            "fr": "Articles à acheter",
            "de": "Einträge zu kaufen",
            "es": "Artículos por comprar"
          }
        }
      ]
    },
    {
      "key": "add_to_meal_plan",
      "label": {
        "en": "Add a recipe to the meal plan",
        "fr": "Ajouter une recette au planning des repas",
        "de": "Rezept zum Essensplan hinzufügen",
        "es": "Añadir una receta al menú"
      },
      "description": {
        "en": "Plans a Mealie recipe for a meal; with no recipe, Mealie picks one at random.",
        "fr": "Prévoit une recette Mealie pour un repas ; sans recette, Mealie en choisit une au hasard.",
        "de": "Plant ein Mealie-Rezept für eine Mahlzeit; ohne Rezept wählt Mealie zufällig eins.",
        "es": "Prevé una receta de Mealie para una comida; sin receta, Mealie elige una al azar."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "recipe",
          "type": "string",
          "label": {
            "en": "Recipe",
            "fr": "Recette",
            "de": "Rezept",
            "es": "Receta"
          },
          "description": {
            "en": "Its name, or part of it. Empty: a random recipe.",
            "fr": "Son nom, ou une partie. Vide : une recette au hasard.",
